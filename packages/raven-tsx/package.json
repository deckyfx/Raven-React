{
  "name": "@decky.fx/raven-tsx",
  "version": "0.2.0",
  "description": "Raven's native widgets from TSX, for Bun: a core that knows only Raven and adapters for React and Solid, with typed components made from Raven's schema",
  "license": "Apache-2.0",
  "type": "module",
  "module": "src/core/index.ts",
  "exports": {
    ".": {
      "bun": "./src/core/index.ts",
      "node": "./dist/node/core/index.js",
      "default": "./src/core/index.ts"
    },
    "./react": {
      "bun": "./src/react/index.ts",
      "node": "./dist/node/react/index.js",
      "default": "./src/react/index.ts"
    },
    "./solid": {
      "bun": "./src/solid/index.ts",
      "node": "./dist/node/solid/index.js",
      "default": "./src/solid/index.ts"
    },
    "./solid/renderer": "./src/solid/renderer.ts",
    "./solid/plugin": "./src/solid/plugin.ts",
    "./solid/preload": "./src/solid/preload.ts"
  },
  "imports": {
    "#backend": {
      "bun": "./src/core/backend/bun.ts",
      "node": "./src/core/backend/node.ts",
      "default": "./src/core/backend/bun.ts"
    },
    "#native": {
      "bun": "./src/core/native.ts",
      "node": "./src/core/native-node.ts",
      "default": "./src/core/native.ts"
    },
    "#raven": {
      "bun": "./src/vendor/raven.ts",
      "node": "./src/vendor/node/raven.js",
      "default": "./src/vendor/raven.ts"
    }
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deckyfx/raven-tsx.git"
  },
  "keywords": [
    "raven",
    "tsx",
    "bun",
    "gui",
    "desktop",
    "native",
    "widgets",
    "react",
    "solid",
    "solidjs",
    "vulkan"
  ],
  "scripts": {
    "generate": "bun run src/tools/generate-components.ts",
    "native:local": "bun run src/tools/native-local.ts",
    "native:windows": "bun run src/tools/native-windows.ts",
    "sync-binding": "bun run src/tools/sync-binding.ts",
    "raven:status": "bun run src/tools/raven-status.ts",
    "raven:check": "bun run src/tools/raven-status.ts --check",
    "raven:update": "bun run src/tools/raven-update.ts",
    "raven:drift": "bun run src/tools/raven-drift.ts",
    "pack:platform": "bun run src/tools/pack-platform.ts",
    "prepare:publish": "bun run src/tools/prepare-publish.ts",
    "check:consumer": "bun run src/tools/check-consumer.ts",
    "test": "bun test",
    "typecheck": "bun check",
    "build:node": "bun run src/tools/build-node.ts"
  },
  "dependencies": {
    "@types/babel__core": "^7.20",
    "@types/react": "^19",
    "@types/react-reconciler": "^0.34"
  },
  "peerDependencies": {
    "@babel/core": "^7.20",
    "babel-preset-solid": "^1.9",
    "react": "^19.3.0",
    "react-reconciler": "^0.34.0",
    "solid-js": "^1.9"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "babel-preset-solid": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-reconciler": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@types/bun": "latest",
    "babel-preset-solid": "1.9.19",
    "react": "^19.3.0",
    "react-reconciler": "^0.34.0",
    "solid-js": "1.9.19",
    "typescript": "^6"
  }
}
